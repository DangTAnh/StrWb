# Copy to .env and fill in real values.
# generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
MESSENGER_URL=https://m.me/yourpage
# Set to true when serving over HTTPS (protects the session cookie)
SESSION_COOKIE_SECURE=false
# Debug off in production; set to 1 only for local dev
FLASK_DEBUG=0
